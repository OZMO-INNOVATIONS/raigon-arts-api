# ========================================================================
# RAIGON ART REST API - ENVIRONMENT CONFIGURATION
# ========================================================================

PORT=5001
NODE_ENV=development

# --- SUPABASE CONFIGURATION ---
# Found in your Supabase Dashboard: Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=raigon-art-storage

# Direct PostgreSQL connection to Supabase (Project Settings -> Database -> Connection string: URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- JWT AUTHENTICATION ---
JWT_SECRET=raigon_super_secret_jwt_key_2026_art_management_system
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=raigon_refresh_secret_key_ultra_secure_2026
JWT_REFRESH_EXPIRES_IN=30d

# --- STORAGE MODE ---
# 'supabase' (uploads directly to Supabase Storage bucket) or 'local' (saves to ./uploads folder)
STORAGE_MODE=supabase
LOCAL_STORAGE_PATH=./uploads
# Public CDN URL prefix (optional override, otherwise defaults to Supabase public bucket URL)
CDN_BASE_URL=

# --- WHATSAPP CLOUD API CONFIGURATION ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
